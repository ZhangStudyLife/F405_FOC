# ---- 构建产物 ----
# CMake/Ninja 生成目录(build/Debug、build/Release),含 CMakeCache、compile_commands.json、
# .elf/.bin/.hex/.map 等,全部可由 CMakeLists.txt 重新生成
build/

# ---- 本地分析产物 ----
# CubeMX 配置排查与验证留下的日志/脚本,非工程组成部分,但本地保留备查
validation/

# ---- CubeMX 备份 ----
# 修改 .ioc 前自动/手动留的备份,真正生效的是 405_FOC.ioc
*.ioc.original.bak
*.ioc.bak

# ---- 编辑器 / IDE ----
# .vscode 只忽略个人化设置;c_cpp_properties.json 是本工程专属的 IntelliSense
# 配置(ARM GCC 路径、STM32 宏、includePath),必须随项目走,否则换机器就满屏红线
.vscode/*
!.vscode/c_cpp_properties.json
.idea/
*.swp
*.swo
*~

# ---- 操作系统 ----
Thumbs.db
Desktop.ini
.DS_Store
